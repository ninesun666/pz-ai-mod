# Only project source, documentation, and authored test mods belong here.
/*
!/.gitignore
!/*.md
!/*.cmd
!/*.ps1
!/agent/
!/bridge/
!/DC_AIVoice/
!/dctoolkit/
!/docs/
!/tests/
!/tools/
!/publish-draft/
!/test-profile/
!/standalone/

/test-profile/*
!/test-profile/mods/
/test-profile/mods/*
!/test-profile/mods/DC_AI_Teammate/
!/test-profile/mods/DC_AITeammateTest/

# Private configuration, runtime data, and generated output.
**/__pycache__/
**/*.pyc
**/*.class
**/classes/
**/node_modules/
**/.venv/
**/build/
**/dist/
**/*.jar
**/*.dll
**/*.exe
**/*.zip
**/*.log
**/*.sqlite*
**/*.db
**/.env
**/.env.*
!/bridge/.env.example
/bridge/config.json
/bridge/*local*.json
/bridge/*secret*
/bridge/*token*
**/zb-config/
**/Saves/
**/backups/
# Generated/unverified art and font assets are not a source baseline.
**/media/textures/
**/media/fonts/
**/*.mp3
**/*.wav
**/*.webm
